# Copy this file to backend/.env and fill in the values:  cp backend/.env.example backend/.env
# Never commit backend/.env: it holds your bot token.

# --- Telegram --------------------------------------------------------------------
# Bot token from @BotFather (/newbot).
BOT_TOKEN=123456:your-bot-token-from-BotFather
# Your own Telegram id (ask @userinfobot). This account becomes the only administrator.
ADMIN_TG_ID=123456789

# --- Mini App address --------------------------------------------------------------
# Public HTTPS address the bot's button opens. Telegram accepts only https://.
# scripts/dev-tunnel.sh fills this in automatically with a Cloudflare quick-tunnel address.
# With a permanent Cloudflare Tunnel, put your own domain here, e.g. https://learn.example.com
WEBAPP_URL=https://your-domain.example

# --- Database ------------------------------------------------------------------------
# SQLite file for local development. docker-compose overrides this with PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./mylearncenter.db

# --- Development ---------------------------------------------------------------------
# true lets the API accept an "X-Dev-User: <telegram id>" header so the app opens in a normal browser.
# Keep false whenever the app is reachable from the internet (tunnel or server).
DEV_MODE=false
# Create three demo themes on first start.
SEED_DEMO_CONTENT=true

# --- AI agent (Claude API) -------------------------------------------------------------
# Key from https://console.anthropic.com. The agent turns uploaded files into lessons and tests.
ANTHROPIC_API_KEY=
# Claude model the agent uses.
AI_MODEL=claude-opus-5
# Largest file a teacher can upload (PDF, Word, text), in megabytes.
MAX_UPLOAD_MB=50
# Days for streaks and daily quests start at midnight here.
TIMEZONE=Asia/Tashkent
